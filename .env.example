# Port for Express server
PORT=3000

# AI Provider Configuration ('gemini', 'openai', or 'heuristic')
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=

# GitHub Personal Access Token (Optional: elevates rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Upload Limits
MAX_FILE_SIZE_MB=25
MAX_ZIP_FILES=1000
MAX_UNCOMPRESSED_SIZE_MB=100
